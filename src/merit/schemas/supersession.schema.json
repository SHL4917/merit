{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "supersession",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^SUP-[0-9]{4}(?![\\s\\S])"
    },
    "supersedes": {
      "type": "string"
    },
    "superseded_by": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string"
    },
    "recorded_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    }
  },
  "required": [
    "schema_version",
    "id",
    "supersedes",
    "superseded_by",
    "reason",
    "recorded_by",
    "recorded_on"
  ],
  "additionalProperties": false
}
