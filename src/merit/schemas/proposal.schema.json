          {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "functional",
                  "constraint",
                  "quality",
                  "interface"
                ]
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "stated",
                  "inferred"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "clarifying",
                  "baselined",
                  "deferred",
                  "withdrawn"
                ]
              },
              "rationale": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "quote": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "source",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "acceptance_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "owner": {
                "type": "string"
              },
