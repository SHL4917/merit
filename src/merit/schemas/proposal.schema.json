                "const": "add_requirement"
              }
            },
            "required": [
              "op",
              "statement",
              "type",
              "provenance",
              "evidence"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
