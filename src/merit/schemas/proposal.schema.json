              "type": {
                "type": "string",
                "enum": [
                  "functional",
                  "constraint",
                  "quality",
                  "interface"
                ]
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "stated",
                  "inferred"
                ]
              },
              "rationale": {
                "type": "string"
