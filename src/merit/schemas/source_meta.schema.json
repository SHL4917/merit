{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_meta",
  "type": "object",
  "properties": {
    "source": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "origin": {
      "type": "string"
    },
    "origin_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "extractor_version": {
      "type": "string"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "transcript",
        "minutes",
        "email",
        "self_recorded_note"
      ]
    },
    "authored_by": {
      "type": "string"
    },
    "session_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "classification": {
      "type": "string"
    },
    "ingested_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    },
    "ingested_by": {
      "type": "string"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  },
  "required": [],
  "additionalProperties": false
}
